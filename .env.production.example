# Production environment — copy to .env on your VPS before starting.
#   cp .env.production.example .env
#
# Generate secrets (run on macOS/Linux):
#   openssl rand -hex 32        # SECRET_KEY
#   openssl rand -hex 24        # CRON_SECRET

# --- Required: domains & TLS (Caddy) ---
API_DOMAIN=api.yourdomain.com
ACME_EMAIL=you@yourdomain.com
PUBLIC_API_URL=https://api.yourdomain.com
FRONTEND_URL=https://app.yourdomain.com
CORS_ORIGINS=https://app.yourdomain.com
ALLOWED_HOSTS=api.yourdomain.com

# --- Required: app security ---
SECRET_KEY=
DEBUG=false
CRON_SECRET=

# --- Required: database ---
# Managed Postgres (Neon, Supabase, RDS, etc.) — recommended:
DATABASE_URL=postgresql://user:password@host:5432/aiemployee?sslmode=require
#
# OR use bundled Postgres on the VPS (also set POSTGRES_* and start with --profile bundled-db):
# DATABASE_URL=postgresql://aiemployee:CHANGE_ME@db:5432/aiemployee
# POSTGRES_USER=aiemployee
# POSTGRES_PASSWORD=
# POSTGRES_DB=aiemployee

# --- Required: AI ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
AI_PROVIDER=groq

# --- Required: Telnyx (voice + SMS) ---
TELNYX_API_KEY=
TELNYX_PUBLIC_KEY=
TELNYX_ACCOUNT_SID=
TELNYX_TEXML_CONNECTION_ID=
TELNYX_MESSAGING_PROFILE_ID=
SMS_PROVIDER=telnyx
VOICE_PROVIDER=telnyx
EMAIL_PROVIDER=auto
VOICE_MODE=gather

# --- Billing ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=

# --- Email (recommended for reminders + escalation fallback) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@yourdomain.com
SMTP_USE_TLS=true

# --- Reminders ---
REMINDERS_ENABLED=true
REMINDER_HOURS_BEFORE=24
REMINDER_CRON_INTERVAL_SECONDS=3600

# --- Monitoring (optional) ---
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1

# --- Performance ---
UVICORN_WORKERS=2

# --- Frontend (set in Vercel dashboard, not on VPS) ---
# NEXT_PUBLIC_API_URL=https://api.yourdomain.com/api/v1
