# Backend
DATABASE_URL=postgresql://aiemployee:aiemployee@localhost:5432/aiemployee
SECRET_KEY=change-me-use-openssl-rand-hex-32
DEBUG=true
CORS_ORIGINS=http://localhost:3000

# AI (Phase 3)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
AI_PROVIDER=groq

# Voice / SMS / Email — swap adapters via env (see backend/app/integrations/registry.py)
# Voice (Telnyx TeXML today; add Twilio adapter under integrations/adapters/)
TELNYX_API_KEY=
TELNYX_PUBLIC_KEY=
TELNYX_ACCOUNT_SID=
TELNYX_PHONE_NUMBER=
TELNYX_MESSAGING_PROFILE_ID=
# TeXML Application connection ID — all tenant numbers are assigned to this connection
TELNYX_TEXML_CONNECTION_ID=
SMS_PROVIDER=telnyx
VOICE_PROVIDER=telnyx
EMAIL_PROVIDER=auto
PUBLIC_API_URL=http://localhost:8000
VOICE_MODE=gather
VOICE_GATHER_SPEECH_TIMEOUT=3
VOICE_GATHER_TIMEOUT=20

# Billing (Phase 5)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
FRONTEND_URL=http://localhost:3000

# Email (optional — logs only when SMTP_HOST unset; booking confirmations + owner escalation)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true

# P4 — appointment reminders (hourly cron via docker compose --profile scheduler)
CRON_SECRET=change-me-cron-secret
REMINDER_HOURS_BEFORE=24
REMINDER_CRON_INTERVAL_SECONDS=3600

# P4 — monitoring (optional)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1

# Telnyx SMS inbound webhook URL: {PUBLIC_API_URL}/api/v1/sms/inbound

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
