# Backend
DATABASE_URL=postgresql://aiemployee:aiemployee@localhost:5432/aiemployee
SECRET_KEY=change-me-use-openssl-rand-hex-32
DEBUG=true
CORS_ORIGINS=http://localhost:3000
ALLOWED_HOSTS=*

# Production only (see .env.production.example and DEPLOY.md)
# API_DOMAIN=api.yourdomain.com
# ACME_EMAIL=you@yourdomain.com

# AI (Phase 3)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
AI_PROVIDER=groq

# Voice / SMS / Email — swap adapters via env (see backend/app/integrations/registry.py)
# Set VOICE_PROVIDER / SMS_PROVIDER to telnyx | twilio | vonage (primary CPaaS)
TELNYX_API_KEY=
TELNYX_PUBLIC_KEY=
TELNYX_ACCOUNT_SID=
TELNYX_PHONE_NUMBER=
TELNYX_MESSAGING_PROFILE_ID=
# TeXML Application connection ID — all tenant numbers are assigned to this connection
TELNYX_TEXML_CONNECTION_ID=

# Twilio (full primary — set VOICE_PROVIDER=twilio and SMS_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=

# Vonage (alternate primary)
VONAGE_API_KEY=
VONAGE_API_SECRET=
VONAGE_SIGNATURE_SECRET=
VONAGE_APPLICATION_ID=
VONAGE_PRIVATE_KEY=
VONAGE_PHONE_NUMBER=

# Plivo (alternate primary — PlivoXML)
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
PLIVO_PHONE_NUMBER=
PLIVO_APP_ID=

# SignalWire Compatibility API / cXML (alternate primary)
SIGNALWIRE_PROJECT_ID=
SIGNALWIRE_API_TOKEN=
SIGNALWIRE_SPACE_URL=
SIGNALWIRE_PHONE_NUMBER=

# VoIP.ms (alternate primary — SMS/DID + SIP routing)
VOIPMS_API_USERNAME=
VOIPMS_API_PASSWORD=
VOIPMS_PHONE_NUMBER=
VOIPMS_DID=
VOIPMS_ROUTING=

SMS_PROVIDER=telnyx
VOICE_PROVIDER=telnyx
EMAIL_PROVIDER=auto
PUBLIC_API_URL=http://localhost:8000
VOICE_MODE=gather
# Optional: lower-latency STT via Deepgram + Telnyx media stream (requires TELNYX_ACCOUNT_SID)
DEEPGRAM_API_KEY=
VOICE_GATHER_SPEECH_TIMEOUT=3
VOICE_GATHER_TIMEOUT=20

# Billing (Phase 5)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
FRONTEND_URL=http://localhost:3000

# Email (optional — logs only when SMTP_HOST unset; booking confirmations + owner escalation)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true

# Rate limiting (optional — enables shared limits across API workers)
REDIS_URL=

# P4 — appointment reminders (hourly cron via docker compose --profile scheduler)
CRON_SECRET=change-me-cron-secret
REMINDER_HOURS_BEFORE=24
REMINDER_CRON_INTERVAL_SECONDS=3600

# P4 — monitoring (optional)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1

# Frontend (optional — browser error reporting)
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development

# Telnyx SMS inbound webhook URL: {PUBLIC_API_URL}/api/v1/sms/inbound

# Frontend — same-origin /api/v1 proxy via Next.js (recommended for HttpOnly auth cookies)
NEXT_PUBLIC_API_URL=/api/v1
# Server-side rewrite target (Next.js only; not exposed to browser)
INTERNAL_API_URL=http://localhost:8000
# Set to true only for operator tooling — hides /dashboard/admin/providers by default
NEXT_PUBLIC_ENABLE_ADMIN_UI=false
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
